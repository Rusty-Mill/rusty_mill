# Not anchored to the workspace root: some subtree-merged crates (e.g.
# rusty_config, see the "cleanup" PR that removed its already-tracked
# target/) had a stray per-crate target/ committed upstream, from being
# built standalone before this workspace existed. Matching it at every
# depth stops that from silently recurring on a future import.
target/

# Python bytecode from running .github/scripts tests locally
__pycache__/
*.pyc

# Runtime SQLite artifacts
meshed_registry.db

# super-board
.claude/super-board/active
.claude/super-board/onboard-answers.json
.claude/super-board/onboard-staged/
.claude/super-board/backup/
.claude/super-board/inflight/
.claude/super-board/migrations/
.claude/super-board/upgrade.json
