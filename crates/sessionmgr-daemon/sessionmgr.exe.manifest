<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Windows application manifest for sessionmgr.exe.

  The one thing here that is load-bearing is `longPathAware`. Without it
  Windows caps paths at MAX_PATH (260 characters) for this process no
  matter what the filesystem or the registry allow.

  That limit is reachable in ordinary use rather than in a contrived case.
  A worktree session's path is
  `<user's repo>/.sessionmgr-worktrees/<12-char id>/...`, and this tool
  controls neither the repository's own location nor the depth of the tree
  a build produces underneath it. Short session ids reduce the exposure
  (see `sessionmgr_core::workspace::worktree_dir`) but cannot remove it:
  a repo already nested 150 characters deep leaves little room, and the
  failure mode without this manifest is git refusing to create or remove a
  worktree with an error that says nothing about path length.

  This manifest is declared but **not yet wired into the build**: embedding
  it requires a `build.rs` invoking a resource compiler, which only runs on
  a Windows toolchain. It is checked in now so the requirement is recorded
  next to the code rather than living in someone's memory, and so the
  Windows verification pass has the file it needs.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      type="win32"
      name="sessionmgr"
      version="0.1.0.0"
      processorArchitecture="*"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <!--
        UTF-8 as the process code page, so paths and command lines with
        non-ASCII characters survive the round trip through the ANSI APIs
        that any child process may still use. A repository under a path
        containing non-ASCII characters is otherwise a quiet corruption
        rather than a loud failure.
      -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. `longPathAware` is only honoured from 1607. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
