{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoragePropertyRow",
  "description": "One typed property in `properties_get`.",
  "type": "object",
  "properties": {
    "key": {
      "description": "Frontmatter key.",
      "type": "string"
    },
    "property_type": {
      "description": "Effective type name (override, else inferred, else the value's shape).",
      "type": "string"
    },
    "value": {
      "description": "JSON projection of the YAML value."
    }
  },
  "additionalProperties": false,
  "required": [
    "key",
    "property_type",
    "value"
  ]
}
