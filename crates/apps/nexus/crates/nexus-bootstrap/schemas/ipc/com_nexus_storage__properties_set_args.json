{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoragePropertiesSetArgs",
  "description": "Args for `com.nexus.storage::properties_set` (handler `90`).",
  "type": "object",
  "properties": {
    "key": {
      "description": "Frontmatter key.",
      "type": "string"
    },
    "path": {
      "description": "Forge-relative markdown path.",
      "type": "string"
    },
    "property_type": {
      "description": "Type to coerce the value to. Default: the effective schema type,\nelse the value's own shape.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "value": {
      "description": "New value, or `null` to remove the key.",
      "default": null
    }
  },
  "additionalProperties": false,
  "required": [
    "path",
    "key"
  ]
}
