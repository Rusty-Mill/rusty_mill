{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StorageNoteRandomArgs",
  "description": "Args for `com.nexus.storage::note_random` (handler `84`).",
  "type": "object",
  "properties": {
    "exclude": {
      "description": "Forge-relative path to leave out of the draw (the caller's active note).",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "prefix": {
      "description": "Restrict the draw to indexed markdown files under this path prefix.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "additionalProperties": false
}
