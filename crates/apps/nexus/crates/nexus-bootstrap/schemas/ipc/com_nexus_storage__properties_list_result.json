{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoragePropertiesListResult",
  "description": "Reply for `com.nexus.storage::properties_list`.",
  "type": "object",
  "properties": {
    "columns": {
      "description": "Every known key (inferred ∪ overrides), sorted — stable across pages.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "description": "The requested window.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/StoragePropertiesListRow"
      }
    },
    "total": {
      "description": "Notes matching the filter before pagination.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "columns",
    "rows",
    "total"
  ],
  "$defs": {
    "StoragePropertiesListRow": {
      "description": "One note in `properties_list`.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Forge-relative path.",
          "type": "string"
        },
        "properties": {
          "description": "Sparse key → JSON value; keys absent from this note are omitted.",
          "type": "object",
          "additionalProperties": true
        },
        "title": {
          "description": "`title` property when present, else the filename stem.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "title",
        "properties"
      ]
    }
  }
}
