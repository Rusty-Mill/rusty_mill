{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoragePropertiesListArgs",
  "description": "Args for `com.nexus.storage::properties_list` (handler `91`).",
  "type": "object",
  "properties": {
    "key": {
      "description": "Only notes carrying this key.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "limit": {
      "description": "Page size; omitted means every row.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "default": null,
      "minimum": 0
    },
    "offset": {
      "description": "Rows to skip.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "default": null,
      "minimum": 0
    },
    "value": {
      "description": "With `key`: only notes whose rendered value equals this string.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "additionalProperties": false
}
