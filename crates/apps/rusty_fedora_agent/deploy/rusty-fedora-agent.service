# REVIEWABLE TEMPLATE -- not applied automatically. Copy to
# /etc/systemd/system/rusty-fedora-agent.service on the target host,
# adjust the paths/bind address below, then:
#
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin \
#     --groups systemd-journal rusty-fedora-agent
#   sudo cp rusty-fedora-agent.service /etc/systemd/system/
#   sudo cp allowlist.toml /etc/rusty-fedora-agent/allowlist.toml   # after editing it
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rusty-fedora-agent.service
#
# Runs as an unprivileged, non-root, no-login system user. Membership in
# systemd-journal (added above) is what makes fedora_read_journal work
# without any further elevation -- see README.md's privilege model.
# Service control (fedora_service_control) and dnf install/remove
# (fedora_dnf_install/fedora_dnf_remove) are elevated separately and
# narrowly via polkit/sudoers -- see deploy/polkit/ and deploy/sudoers.d/.

[Unit]
Description=rusty_fedora_agent -- scoped systemd/dnf/config agent for rusty_homelab_mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rusty-fedora-agent
Group=rusty-fedora-agent
ExecStart=/usr/local/bin/rusty_fedora_agent \
    --bind 127.0.0.1:8765 \
    --allowlist /etc/rusty-fedora-agent/allowlist.toml
Restart=on-failure
RestartSec=5s

# Defense in depth on top of the allowlist/polkit/sudoers scoping above --
# none of this agent's own operations need broader filesystem or
# capability access than this.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# dnf/systemctl/journalctl need to run and reach D-Bus/the package
# database, so this is not a fully sealed sandbox -- ReadWritePaths below
# is deliberately narrow rather than opening up ProtectSystem entirely.
ReadWritePaths=/var/lib/dnf /var/cache/dnf

[Install]
WantedBy=multi-user.target
