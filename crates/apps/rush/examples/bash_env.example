# ==============================================================================
# examples/bash_env.example — Sample Non-Interactive Script Configuration File
# Set export BASH_ENV="$HOME/.bash_env" to source this file for sub-scripts.
# ==============================================================================

# Enable strict pipefail handling for scripts
set -o pipefail

# Script helper functions
log_info() {
    echo "[INFO] $(date '+%H:%M:%S') $1"
}

log_error() {
    echo "[ERROR] $(date '+%H:%M:%S') $1" >&2
}

# Environment indicators
export CI_ENVIRONMENT="production"
