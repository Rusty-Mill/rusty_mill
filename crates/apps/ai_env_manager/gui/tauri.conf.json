{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ai Env Manager",
  "version": "0.1.0",
  "identifier": "dev.rustymill.aienvmanager",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "title": "Ai Env Manager",
        "width": 1000,
        "height": 640,
        "minWidth": 720,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
