# systemd unit: one Mill Board backup, run by mill-board-backup.timer.
# Install to /etc/systemd/system/ with the timer and /usr/local/bin/mill-board-backup (see README.md).
# The board stays up: the SQLite online backup needs no stop.
[Unit]
Description=Mill Board backup
After=mill-board.service

[Service]
Type=oneshot
User=baileyrd
# MILL_BOARD_DB from board.env; the backup settings from backup.env, never board.env: the
# board refuses to start while it holds a MILL_BOARD_BACKUP_* line.
EnvironmentFile=/home/baileyrd/.mill-board/board.env
EnvironmentFile=/home/baileyrd/.mill-board/backup.env
# A hung copy must not hold off later runs: fail after an hour (rsync also times out idle I/O).
TimeoutStartSec=1h
ExecStart=/usr/local/bin/mill-board-backup
ProtectSystem=strict
ProtectHome=read-only
# The local copies, and the off-host mount (the leading - skips a mount that is absent; backup.sh
# then refuses to ship, see MILL_BOARD_BACKUP_REQUIRE_MOUNT). A destination elsewhere needs its
# own ReadWritePaths= in a drop-in: `systemctl edit mill-board-backup.service`.
ReadWritePaths=/home/baileyrd/.mill-board -/mnt/beast/mill-board
NoNewPrivileges=true
PrivateTmp=true
