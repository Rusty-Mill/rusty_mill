# Copy to ~/.mill-board/board.env and chmod 600. systemd reads it; no shell, no quotes.

# The board file (three files: this, .records, .inserts) and its lock.
MILL_BOARD_STORE=/home/baileyrd/.mill-board/board.mmap

# Agents (a token each, bound to an actor and role), projects, roles, GitHub sync.
# The first start creates identities.json with an `admin` and writes its token to
# settings/first-admin.token (owner-only). Read it, then delete the file.
MILL_BOARD_SETTINGS_DIR=/home/baileyrd/.mill-board/settings

# Loopback until you need more. For other machines on the LAN use 0.0.0.0:8787 and list
# every name callers use in MILL_BOARD_ALLOWED_HOSTS. The server speaks plain HTTP, so
# on a LAN every token crosses the wire in the clear: put TLS in front or stay on loopback.
MILL_BOARD_HTTP=127.0.0.1:8787
MILL_BOARD_ALLOWED_HOSTS=127.0.0.1,localhost

# A backup of the store and settings every day, the newest 14 kept; the store is
# compacted after each.
MILL_BOARD_BACKUP_DIR=/home/baileyrd/.mill-board/backups
MILL_BOARD_BACKUP_SECS=86400
MILL_BOARD_BACKUP_KEEP=14

# Optional GitHub issue sync (needs issues read/write on the repo).
# MILL_BOARD_GITHUB_REPO=owner/name
# GITHUB_TOKEN=
