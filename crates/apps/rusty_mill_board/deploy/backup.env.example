# Copy to ~/.mill-board/backup.env and chmod 600. Read only by mill-board-backup.service, never by
# the board (which refuses to start while board.env holds a MILL_BOARD_BACKUP_* line).
# MILL_BOARD_DB comes from board.env.

# Local copies, newest N kept.
MILL_BOARD_BACKUP_DIR=/home/baileyrd/.mill-board/backups
MILL_BOARD_BACKUP_KEEP=14

# An rsync target off this host (copies go to <target>/<hostname>/), e.g. a mount or user@host:path.
MILL_BOARD_BACKUP_DEST=/mnt/beast/mill-board
