[{"MessageAppended":{"id":3,"from":"reviewer","from_role":"reviewer","draft":{"kind":"Verdict","to":["All"],"body":{"Verdict":{"subject":4,"run":1,"verdict":"Approve","blocking":[],"non_blocking":[{"id":"nb1","reference":{"Art":{"id":3,"fragment":null}},"issue":"The accent policy (fold to ASCII) is the spec's proposed default. The human has not confirmed it. The code implements that default correctly: slug(\"Café au lait\") gives \"cafe-au-lait\".","fix":"Get the human to confirm the policy before merge. If they reject it, only the fold match needs to change."},{"id":"nb2","reference":{"Art":{"id":3,"fragment":null}},"issue":"Decomposed accents (e followed by U+0301) are not folded. The combining mark becomes a separator, so \"ét\" gives \"e-t\". This is allowed by the spec, since other non-ASCII is a separator, but it could surprise users.","fix":"Optionally document this in the doc comment, or skip combining marks (U+0300..U+036F) without emitting a separator."},{"id":"nb3","reference":{"Art":{"id":3,"fragment":null}},"issue":"The empty-string sentinel for 'no fold' and the buf/piece juggling are slightly indirect. The added slug_tests module is small, and its single test mixes several cases.","fix":"Use Option<&str> for the fold result and split the test into separate cases, for example one for accents and one for separators."}]}},"refs":[{"Art":{"id":4,"fragment":null}}],"evidence":[{"Art":{"id":6,"fragment":null}},{"Art":{"id":3,"fragment":"L1-L35"}}],"reply_to":null,"yield_to":null,"gate":false}}},{"Charged":{"principal":"reviewer","turn":4,"messages":1,"bytes":0,"reads":0}},{"TurnEnded":{"turn":4,"cause":"Verdict"}},{"StateChanged":{"from":"Review","to":"MergeGate"}},{"OpAccepted":{"principal":"reviewer","op":"t4-2","payload":"318e7606a42168f042bee2af8ca975a3af26b8355b291e65f8f2b63d5793562c","response":{"Posted":3}}}]
