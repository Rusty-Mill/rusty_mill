# rusty_homelab_mcp Fedora host registry.
#
# Maps a host id -- what a fedora_* tool's `host` argument names -- to the
# base URL of the rusty_fedora_agent instance running on that host. Copy
# this to a real path and pass it via --fedora-hosts-file (or the
# FEDORA_HOSTS_FILE environment variable).
#
# The default host id, "baileyai", can also be set with the older
# --fedora-agent-url / FEDORA_AGENT_URL flag alone, with no file at all --
# that flag and an entry here for "baileyai" both work, and this file wins
# if both are set. Every other host id needs an entry here.
#
# Each entry's base_url carries its own port, so nothing requires the
# agent's HTTP port to be identical across hosts -- pick whatever's free
# on each one. In practice every instance here still uses the agent's own
# default (8765), for one less thing to track.

[hosts.baileyai]
base_url = "http://192.168.10.104:8765"

[hosts.samba-lxc-101]
base_url = "http://192.168.10.192:8765"
