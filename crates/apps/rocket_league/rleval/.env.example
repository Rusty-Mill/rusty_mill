# Copy to `.env` (gitignored) and fill in your token. The corpus data-tooling
# scripts under assets/corpus/ load this automatically via _env.load_dotenv(),
# so you don't have to export BC_TOKEN each shell. A real environment variable,
# if set, still takes precedence over this file.
#
# Get a token at https://ballchasing.com/upload (Account -> API key).
BC_TOKEN=your-ballchasing-token-here
