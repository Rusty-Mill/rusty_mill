# Used by BuildKit for this Dockerfile in place of the root .dockerignore: the
# build context is the monorepo root (see the Dockerfile).
.git
target
**/target
**/__pycache__
**/*.pyc
**/.pytest_cache
**/node_modules
crates/apps/rocket_league/rleval/service/*.db
crates/apps/rocket_league/rleval/service/blobs/
crates/apps/rocket_league/rleval/data/
# Local environment, credentials and state never belong in an image.
**/.env
**/.env.*
**/.venv
**/venv
