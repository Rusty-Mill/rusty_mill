# Copy to ~/.rusty_tick/tick.env and chmod 600. systemd reads it; no shell, no quotes.

# The task store. Copy an existing data directory here with the server stopped.
RUSTY_TICK_DATA_DIR=/home/baileyrd/.rusty_tick/data

# The built web UI (web/dist), served at /.
RUSTY_TICK_WEB_DIR=/home/baileyrd/.rusty_tick/web

# Loopback, on 8788 so Mill Board keeps 8787 on the same host. Plain HTTP: reach it
# from elsewhere through TLS in front or an SSH tunnel, not by widening this.
RUSTY_TICK_ADDR=127.0.0.1:8788

# The single-user API token (16+ characters). Mill Board's board.env carries the same
# value. For a multi-user directory (users.json, ADR-0002) delete this line: an empty
# value still counts as set, and the server refuses to start.
RUSTY_TICK_TOKEN=

# OAuth sign-in for /mcp (claude.ai connectors): the public https origin in front of this
# server. Leave it commented out to keep OAuth off; an empty value refuses to start.
# RUSTY_TICK_ISSUER=https://tick.baileyfam.us

# Backups (rusty-tick-backup.timer). Archives of the stopped data directory go to
# RUSTY_TICK_BACKUP_DIR, the newest RUSTY_TICK_BACKUP_KEEP of them, mirrored to
# RUSTY_TICK_BACKUP_DEST/<hostname>: any rsync target off this host (user@host:/path over SSH, or a
# mounted share). The archives hold users.json and oauth.json: keep the destination private.
RUSTY_TICK_BACKUP_DIR=/home/baileyrd/.rusty_tick/backups
RUSTY_TICK_BACKUP_KEEP=14
RUSTY_TICK_BACKUP_DEST=
