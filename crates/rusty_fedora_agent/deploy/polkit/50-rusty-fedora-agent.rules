// REVIEWABLE TEMPLATE -- not applied automatically. Copy to
// /etc/polkit-1/rules.d/50-rusty-fedora-agent.rules on the target host
// (root-owned, mode 0644) and edit ALLOWED_UNITS below to match
// deploy/allowlist.toml's `units` list exactly -- the two are not the
// same enforcement point (this agent's own allowlist check runs first
// and is not a substitute for the polkit rule below), but they must
// agree, or a unit permitted in one and not the other just fails
// confusingly at whichever layer refuses it.
//
// Restart polkit after installing: `systemctl restart polkit`.
//
// systemd's own D-Bus API (which `systemctl` talks to, even when
// invoked from an unprivileged user) checks
// org.freedesktop.systemd1.manage-units for start/stop/restart and
// org.freedesktop.systemd1.manage-unit-files for enable/disable, and
// since systemd v246 passes the unit name as an action detail
// (action.lookup("unit")) -- this rule keys on that rather than granting
// the action wholesale, so it only ever authorizes the specific units
// listed, not "manage any unit".

// Keep in sync with deploy/allowlist.toml's `units` list.
var ALLOWED_UNITS = [
    // "ollama.service",
];

polkit.addRule(function(action, subject) {
    var isUnitAction =
        action.id == "org.freedesktop.systemd1.manage-units" ||
        action.id == "org.freedesktop.systemd1.manage-unit-files";
    if (!isUnitAction) {
        return polkit.Result.NOT_HANDLED;
    }

    var unit = action.lookup("unit");
    if (unit && subject.user == "rusty-fedora-agent" && ALLOWED_UNITS.indexOf(unit) !== -1) {
        return polkit.Result.YES;
    }

    // Not our subject/unit -- defer to whatever other rule or the
    // interactive-auth default would otherwise apply. Never returns YES
    // for an unlisted unit or a different user.
    return polkit.Result.NOT_HANDLED;
});
