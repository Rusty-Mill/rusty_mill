{
  "name": "@rusty-mill/agui-react",
  "version": "0.1.0",
  "description": "React binding for @rusty-mill/agui-core: an AgentProvider store and the useAgent, useReadable, useAction and useSharedState hooks. Headless: hooks and render functions, no components.",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.3.0"
  },
  "dependencies": {
    "@rusty-mill/agui-core": "file:../agui-core"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2"
  }
}
