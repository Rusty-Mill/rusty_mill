{
  "name": "@rusty-mill/agui-vue",
  "version": "0.1.0",
  "description": "Vue binding for @rusty-mill/agui-core: provideAgent and the useAgent, useReadable, useAction and useSharedState composables. Headless: composables and render functions, no components.",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@rusty-mill/agui-core": "file:../agui-core"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2",
    "vue": "^3.5.0"
  }
}
