[Unit]
Description=tailscale-rs (rusty_tail) pure-Rust Tailscale client
Documentation=https://github.com/baileyrd/rusty_tail
Wants=network-online.target
After=network-online.target

[Service]
# Adjust --login-server and provide the auth key out-of-band (an
# EnvironmentFile keeps the key out of the unit and the process table).
#   /etc/tailscale-rs/env  ->  TS_AUTHKEY=tskey-...
EnvironmentFile=/etc/tailscale-rs/env
ExecStart=/usr/local/bin/ts-daemon \
    --login-server https://headscale.example.com \
    --authkey ${TS_AUTHKEY} \
    --state-dir /var/lib/tailscale-rs \
    --tun ts0 \
    --direct \
    --hosts-file /etc/hosts \
    --socket /run/tailscale/tailscaled.sock

# The default LocalAPI path lives under /run/tailscale; create it.
RuntimeDirectory=tailscale
StateDirectory=tailscale-rs

# A TUN device and route/address changes need CAP_NET_ADMIN; nothing more.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

Restart=on-failure
RestartSec=5
# ts-daemon exits cleanly on SIGTERM (systemctl stop).
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
