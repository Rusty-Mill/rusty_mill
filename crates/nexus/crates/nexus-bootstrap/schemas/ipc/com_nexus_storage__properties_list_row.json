{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoragePropertiesListRow",
  "description": "One note in `properties_list`.",
  "type": "object",
  "properties": {
    "path": {
      "description": "Forge-relative path.",
      "type": "string"
    },
    "properties": {
      "description": "Sparse key → JSON value; keys absent from this note are omitted.",
      "type": "object",
      "additionalProperties": true
    },
    "title": {
      "description": "`title` property when present, else the filename stem.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "path",
    "title",
    "properties"
  ]
}
