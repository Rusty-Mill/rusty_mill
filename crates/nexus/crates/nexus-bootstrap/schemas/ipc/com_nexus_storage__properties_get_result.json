{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoragePropertiesGetResult",
  "description": "Reply for `com.nexus.storage::properties_get` (handler `89`; args are\nthe shared `{ path }`).",
  "type": "object",
  "properties": {
    "rows": {
      "description": "Frontmatter keys in document order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/StoragePropertyRow"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "rows"
  ],
  "$defs": {
    "StoragePropertyRow": {
      "description": "One typed property in `properties_get`.",
      "type": "object",
      "properties": {
        "key": {
          "description": "Frontmatter key.",
          "type": "string"
        },
        "property_type": {
          "description": "Effective type name (override, else inferred, else the value's shape).",
          "type": "string"
        },
        "value": {
          "description": "JSON projection of the YAML value."
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "property_type",
        "value"
      ]
    }
  }
}
