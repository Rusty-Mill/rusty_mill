# ==============================================================================
# examples/rushrc.example — Sample Interactive Configuration File for rush
# Copy this file to ~/.rushrc to use as your personal interactive shell config.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & History Controls
# ------------------------------------------------------------------------------
export HISTFILE="$HOME/.rush_history"
export HISTSIZE=5000
# HISTCONTROL: ignoredups (don't repeat), ignorespace (leading space hides from history), erasedups
export HISTCONTROL="ignoreboth:erasedups"
# HISTIGNORE: colon-separated glob patterns to exclude from history
export HISTIGNORE="ls:ll:cd:pwd:exit:clear:history"
# HISTTIMEFORMAT: per-entry timestamp formatting stored in history
export HISTTIMEFORMAT="%Y-%m-%d %H:%M:%S "

# Default editor
export EDITOR="vim"
export VISUAL="code"

# ------------------------------------------------------------------------------
# 2. Prompts & Visual Styling
# ------------------------------------------------------------------------------
# Primary Prompt ($PS1): \u (user), \h (host), \w (cwd), \$ (user symbol)
export PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

# Continuation Prompt ($PS2)
export PS2='> '

# Right-Side Prompt ($RPS1) — shows last exit status if non-zero
export RPS1='$(code=$?; if [ $code -ne 0 ]; then echo "[$code]"; fi)'

# PROMPT_COMMAND: Run before each primary prompt (updates terminal title bar)
export PROMPT_COMMAND='printf "\033]0;rush: %s\007" "$PWD"'

# ------------------------------------------------------------------------------
# 3. Shell Options (shopt)
# ------------------------------------------------------------------------------
shopt -s globstar     # Recursive ** globbing (e.g. src/**/*.rs)
shopt -s extglob      # Extended pattern matching (@(a|b), !(pat), +(pat))
shopt -s nullglob     # Non-matching globs expand to nothing
shopt -s dotglob      # Include hidden dotfiles in glob matches

# ------------------------------------------------------------------------------
# 4. Aliases
# ------------------------------------------------------------------------------
alias ls='ls --color=auto'
alias ll='ls -la'
alias la='ls -A'
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline -n 10'
alias ..='cd ..'
alias ...='cd ../..'

# ------------------------------------------------------------------------------
# 5. Helper Functions & Hooks
# ------------------------------------------------------------------------------
# Create directory and enter it immediately
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Hook for command-not-found (exit status 127)
command_not_found_handle() {
    echo "rush: command not found: $1" >&2
    return 127
}

# ------------------------------------------------------------------------------
# 6. Line Editor Settings
# ------------------------------------------------------------------------------
set -o emacs
