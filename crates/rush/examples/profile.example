# ==============================================================================
# examples/profile.example — Sample Login Shell Configuration File
# Copy this file to ~/.profile to use for login shell sessions (rush --login).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PATH Extensions
# ------------------------------------------------------------------------------
if [ -d "$HOME/.local/bin" ]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

if [ -d "$HOME/bin" ]; then
    export PATH="$HOME/bin:$PATH"
fi

if [ -d "$HOME/.cargo/bin" ]; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi

# ------------------------------------------------------------------------------
# 2. Locale & Defaults
# ------------------------------------------------------------------------------
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

export PAGER="less"
export LESS="-R"
