{
  "version": 1,
  "description": "rusty_mill build board (autonomy policy accepted 2026-10-15)",
  "project": {
    "owner": "Rusty-Mill",
    "title": "Rusty_mill board",
    "number": 1
  },
  "worker_backend": "workflow",
  "model_tier": "medium",
  "target": {
    "type": "repo",
    "url": null
  },
  "repo": {
    "path": ".",
    "remote": "https://github.com/Rusty-Mill/rusty_mill"
  },
  "base_branch": "main",
  "timezone": "America/Chicago",
  "columns": [
    "Backlog",
    "Ready",
    "Building",
    "QA",
    "Review",
    "Blocked",
    "Done"
  ],
  "labels": [
    "qa",
    "bug",
    "feature"
  ],
  "paths": {
    "project_md": "docs/super-board/PROJECT.md",
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": false,
  "merge_policy": {
    "default": "human",
    "handoff_to": "dottiusmaximus",
    "auto_max_lines": 400,
    "allow_auto_on_production": true,
    "method": "merge",
    "always_human": {}
  },
  "migrations": {
    "allowed_envs": [],
    "target_env": "staging",
    "commands": {},
    "checks": {},
    "human_steps": []
  },
  "no_progress_cycles": 6,
  "truth_gate": "non-trivial",
  "truth_threshold": 70,
  "usage_pause_pct": 95,
  "usage_fallback": "none",
  "verify_commands": [],
  "max_workers": 2,
  "rebuild_cap": 2,
  "block_rate_alert_pct": 30,
  "collect": {
    "sources": [
      "github",
      "prs",
      "architecture"
    ],
    "window_days": 14,
    "prs": {
      "max_prs": 200
    },
    "architecture": {
      "max_findings": 5
    },
    "custom": []
  },
  "notifications": {
    "channel": "session",
    "chat_id": null,
    "bot_identity": "baileyrd"
  },
  "ci_required_checks": [
    "required-gate"
  ]
}
